<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Günlük Haberler — {{ date_label }}</title>
  <style>
    /* ── CSS Variables (tema sistemi) ── */
    :root {
      --bg:          #f5f7fa;
      --bg-card:     #ffffff;
      --bg-nav:      #ffffff;
      --bg-header:   linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      --text:        #1a1a2e;
      --text-muted:  #6b7280;
      --text-meta:   #95a5a6;
      --border:      #e8ecf0;
      --accent:      #4fc3f7;
      --accent-dark: #1a6ea8;
      --link:        #2980b9;
      --shadow:      rgba(0,0,0,0.08);
      --badge-bg:    #eef2f7;
      --badge-text:  #555;
      --search-bg:   #f0f4f8;
    }
    [data-theme="dark"] {
      --bg:          #0f1117;
      --bg-card:     #1a1d27;
      --bg-nav:      #1a1d27;
      --bg-header:   linear-gradient(135deg, #0a0a14 0%, #0d1020 100%);
      --text:        #e2e8f0;
      --text-muted:  #94a3b8;
      --text-meta:   #64748b;
      --border:      #2d3748;
      --accent:      #38bdf8;
      --accent-dark: #7dd3fc;
      --link:        #60a5fa;
      --shadow:      rgba(0,0,0,0.4);
      --badge-bg:    #2d3748;
      --badge-text:  #cbd5e1;
      --search-bg:   #252836;
    }

    /* ── Kategori renkleri ── */
    :root {
      --cat-arastirma:    #7c3aed;
      --cat-muhendislik:  #0891b2;
      --cat-urun:         #d97706;
      --cat-kullanici:    #059669;
      --cat-regulasyon:   #dc2626;
      --cat-yatirim:      #b45309;
      --cat-acik-kaynak:  #16a34a;
      --cat-genel:        #6b7280;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      transition: background 0.2s, color 0.2s;
    }

    /* ── Header ── */
    header {
      background: var(--bg-header);
      color: #e0e0e0;
      padding: 2rem 1rem 1.5rem;
      text-align: center;
      position: relative;
    }
    header h1 {
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: -0.5px;
      color: #ffffff;
    }
    header h1 span { color: var(--accent); }
    .meta {
      margin-top: 0.5rem;
      font-size: 0.85rem;
      color: #90a4b7;
    }

    /* ── Tema toggle butonu ── */
    #theme-toggle {
      position: absolute;
      top: 1.1rem;
      right: 1.1rem;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px;
      color: #fff;
      cursor: pointer;
      font-size: 1.1rem;
      padding: 0.35rem 0.6rem;
      transition: background 0.2s;
      line-height: 1;
    }
    #theme-toggle:hover { background: rgba(255,255,255,0.22); }

    /* ── Arama kutusu ── */
    .search-bar {
      background: var(--bg-nav);
      border-bottom: 1px solid var(--border);
      padding: 0.6rem 1rem;
    }
    .search-inner {
      max-width: 900px;
      margin: 0 auto;
      position: relative;
    }
    #search-input {
      width: 100%;
      padding: 0.5rem 0.75rem 0.5rem 2.2rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--search-bg);
      color: var(--text);
      font-size: 0.88rem;
      outline: none;
      transition: border-color 0.15s;
    }
    #search-input:focus { border-color: var(--accent); }
    #search-input::placeholder { color: var(--text-muted); }
    .search-icon {
      position: absolute;
      left: 0.65rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 0.9rem;
      pointer-events: none;
    }
    #search-count {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.3rem;
      min-height: 1.2em;
    }

    /* ── Nav ── */
    nav {
      background: var(--bg-nav);
      border-bottom: 2px solid var(--border);
      padding: 0.65rem 1rem;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .nav-inner {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      align-items: center;
    }
    .nav-label {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-right: 0.2rem;
    }
    nav a.cat-link {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.22rem 0.6rem;
      border-radius: 999px;
      font-size: 0.76rem;
      font-weight: 500;
      text-decoration: none;
      background: var(--badge-bg);
      color: var(--badge-text);
      transition: background 0.15s, color 0.15s, opacity 0.15s;
      white-space: nowrap;
      border: 1.5px solid transparent;
    }
    nav a.cat-link:hover {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .count-badge {
      background: rgba(0,0,0,0.12);
      border-radius: 999px;
      font-size: 0.65rem;
      padding: 0 0.35rem;
      font-weight: 600;
    }

    /* ── Main ── */
    main {
      max-width: 900px;
      margin: 1.5rem auto;
      padding: 0 1rem;
    }

    /* ── Section ── */
    section {
      margin-bottom: 2.5rem;
    }
    .section-header {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2.5px solid var(--border);
    }
    .section-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .section-icon {
      font-size: 1.25rem;
      line-height: 1;
    }
    section h2 {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text);
    }
    .section-count {
      font-size: 0.78rem;
      color: var(--text-meta);
      font-weight: 400;
    }

    /* ── Kategori renk dot'ları ── */
    [data-cat="arastirma"]    .section-dot { background: var(--cat-arastirma); }
    [data-cat="muhendislik-mimari"] .section-dot { background: var(--cat-muhendislik); }
    [data-cat="urun-sirket-haberleri"] .section-dot { background: var(--cat-urun); }
    [data-cat="kullanici-etkileyen"] .section-dot { background: var(--cat-kullanici); }  /* tr: kullanıcıyı etkileyen */
    [data-cat="regulasyon-politika"] .section-dot { background: var(--cat-regulasyon); }
    [data-cat="yatirim-startup"] .section-dot { background: var(--cat-yatirim); }
    [data-cat="acik-kaynak"] .section-dot { background: var(--cat-acik-kaynak); }
    [data-cat="genel"] .section-dot { background: var(--cat-genel); }

    /* Sol border rengi bölüm başlığında */
    [data-cat="arastirma"]    .section-header { border-bottom-color: var(--cat-arastirma); }
    [data-cat="muhendislik-mimari"] .section-header { border-bottom-color: var(--cat-muhendislik); }
    [data-cat="urun-sirket-haberleri"] .section-header { border-bottom-color: var(--cat-urun); }
    [data-cat="kullanici-etkileyen"] .section-header { border-bottom-color: var(--cat-kullanici); }
    [data-cat="regulasyon-politika"] .section-header { border-bottom-color: var(--cat-regulasyon); }
    [data-cat="yatirim-startup"] .section-header { border-bottom-color: var(--cat-yatirim); }
    [data-cat="acik-kaynak"] .section-header { border-bottom-color: var(--cat-acik-kaynak); }

    /* ── Haber listesi ── */
    ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    li.news-item {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.85rem 1.1rem;
      transition: box-shadow 0.15s, border-color 0.15s;
    }
    li.news-item:hover {
      box-shadow: 0 2px 12px var(--shadow);
      border-color: var(--accent);
    }
    li.news-item.hidden { display: none; }

    .item-title a {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--link);
      text-decoration: none;
      line-height: 1.4;
    }
    .item-title a:hover { text-decoration: underline; color: var(--accent-dark); }
    .item-meta {
      margin-top: 0.3rem;
      font-size: 0.73rem;
      color: var(--text-meta);
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      align-items: center;
    }
    .source-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      background: var(--badge-bg);
      color: var(--badge-text);
      border-radius: 4px;
      padding: 0.1rem 0.4rem;
      font-weight: 500;
      font-size: 0.72rem;
    }
    .source-favicon {
      width: 12px;
      height: 12px;
      border-radius: 2px;
      object-fit: contain;
    }
    .item-summary {
      margin-top: 0.4rem;
      font-size: 0.82rem;
      color: var(--text-muted);
      line-height: 1.5;
    }
    .tr-summary {
      color: #16a34a;
      font-style: italic;
    }
    [data-theme="dark"] .tr-summary { color: #4ade80; }

    /* ── Footer ── */
    footer {
      text-align: center;
      padding: 2rem 1rem;
      font-size: 0.78rem;
      color: var(--text-meta);
      border-top: 1px solid var(--border);
    }
    footer a { color: var(--accent); text-decoration: none; }
    footer a:hover { text-decoration: underline; }

    /* ── Arama: eşleşme yok mesajı ── */
    .no-results {
      text-align: center;
      padding: 2rem;
      color: var(--text-muted);
      font-size: 0.9rem;
      display: none;
    }

    /* ── Öne çıkan haberler ── */
    .featured-section {
      margin-bottom: 2.5rem;
    }
    .featured-header {
      border-bottom-color: #f59e0b !important;
    }
    .featured-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 0.75rem;
    }
    .featured-item {
      border-left: 3px solid #f59e0b;
    }
    .cat-pill {
      display: inline-block;
      font-size: 0.68rem;
      padding: 0.1rem 0.45rem;
      border-radius: 999px;
      background: var(--badge-bg);
      color: var(--badge-text);
      font-weight: 500;
      margin-left: 0.4rem;
      vertical-align: middle;
    }

    /* ── Konu grubu badge ── */
    .topic-badge {
      display: inline-block;
      font-size: 0.68rem;
      padding: 0.1rem 0.45rem;
      border-radius: 4px;
      background: #dbeafe;
      color: #1d4ed8;
      font-weight: 500;
      margin-left: 0.4rem;
      vertical-align: middle;
    }
    [data-theme="dark"] .topic-badge {
      background: #1e3a5f;
      color: #93c5fd;
    }

    /* ── Responsive ── */
    @media (max-width: 600px) {
      header h1 { font-size: 1.3rem; }
      li.news-item { padding: 0.7rem 0.85rem; }
      .item-title a { font-size: 0.88rem; }
      nav a.cat-link { font-size: 0.7rem; padding: 0.18rem 0.45rem; }
      #theme-toggle { top: 0.75rem; right: 0.75rem; font-size: 1rem; }
    }
  </style>
</head>
<body>

<header>
  <button id="theme-toggle" aria-label="Temayı değiştir" title="Karanlık/aydınlık mod">🌙</button>
  <h1><span>AI</span> Günlük Haberler</h1>
  <p class="meta">
    {{ date_label }} &nbsp;·&nbsp;
    {{ total_count }} haber &nbsp;·&nbsp;
    Son güncelleme: {{ generated_at }} UTC
  </p>
</header>

<div class="search-bar">
  <div class="search-inner">
    <span class="search-icon">🔍</span>
    <input type="search" id="search-input" placeholder="Haberlerde ara..." autocomplete="off" aria-label="Haberlerde ara">
  </div>
  <div class="search-inner"><div id="search-count"></div></div>
</div>

<nav aria-label="Kategori gezintisi">
  <div class="nav-inner">
    <span class="nav-label">Kategoriler</span>
    {% if featured %}
    <a class="cat-link" href="#one-cikanlar" style="border-color: #f59e0b; background: #fef3c7; color: #92400e;">
      ⭐ Öne Çıkanlar
      <span class="count-badge">{{ featured | length }}</span>
    </a>
    {% endif %}
    {% for cat in category_order %}
      {% if categories[cat] %}
        <a class="cat-link" href="#{{ cat | slugify }}">
          {{ cat | category_icon }} {{ cat }}
          <span class="count-badge">{{ categories[cat] | length }}</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</nav>

<main>
  <p class="no-results" id="no-results">Aramanızla eşleşen haber bulunamadı.</p>

  {% if featured %}
  <section id="one-cikanlar" class="featured-section" aria-labelledby="heading-featured">
    <div class="section-header featured-header">
      <span class="section-icon" aria-hidden="true">⭐</span>
      <h2 id="heading-featured">
        Bugünün Öne Çıkanları
        <span class="section-count">({{ featured | length }} haber)</span>
      </h2>
    </div>
    <ul class="featured-list">
      {% for item in featured %}
      <li class="news-item featured-item" data-title="{{ item.title | lower }}" data-summary="{{ item.tr_summary | default('') | lower }}">
        <div class="item-title">
          <a href="{{ item.url }}"
             target="_blank"
             rel="noopener noreferrer">{{ item.title }}</a>
          <span class="cat-pill">{{ item.category | category_icon }} {{ item.category }}</span>
        </div>
        <div class="item-meta">
          <span class="source-badge">
            <img class="source-favicon"
                 src="https://www.google.com/s2/favicons?domain={{ item.url }}&sz=16"
                 alt=""
                 loading="lazy"
                 onerror="this.style.display='none'">
            {{ item.source_name }}
          </span>
          <span>{{ item.published | format_date }}</span>
        </div>
        {% if item.tr_summary is defined and item.tr_summary %}
        <p class="item-summary tr-summary">🇹🇷 {{ item.tr_summary }}</p>
        {% elif item.summary %}
        <p class="item-summary">{{ item.summary }}</p>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% for cat in category_order %}
    {% if categories[cat] %}
    <section id="{{ cat | slugify }}" data-cat="{{ cat | slugify }}" aria-labelledby="heading-{{ cat | slugify }}">
      <div class="section-header">
        <span class="section-dot" aria-hidden="true"></span>
        <span class="section-icon" aria-hidden="true">{{ cat | category_icon }}</span>
        <h2 id="heading-{{ cat | slugify }}">
          {{ cat }}
          <span class="section-count">({{ categories[cat] | length }} haber)</span>
        </h2>
      </div>
      <ul>
        {% for item in categories[cat] %}
        <li class="news-item" data-title="{{ item.title | lower }}" data-summary="{{ item.tr_summary | default('') | lower }}">
          <div class="item-title">
            <a href="{{ item.url }}"
               target="_blank"
               rel="noopener noreferrer">{{ item.title }}</a>
            {% set item_hash = item.url_hash if item.url_hash is defined else '' %}
            {% if item_hash and topic_groups is defined and item_hash in topic_groups %}
            <span class="topic-badge" title="Birden fazla kaynak bu konuyu haberleştirdi">🔗 Çoklu kaynak</span>
            {% endif %}
          </div>
          <div class="item-meta">
            <span class="source-badge">
              <img class="source-favicon"
                   src="https://www.google.com/s2/favicons?domain={{ item.url }}&sz=16"
                   alt=""
                   loading="lazy"
                   onerror="this.style.display='none'">
              {{ item.source_name }}
            </span>
            <span>{{ item.published | format_date }}</span>
          </div>
          {% if item.tr_summary is defined and item.tr_summary %}
          <p class="item-summary tr-summary">🇹🇷 {{ item.tr_summary }}</p>
          {% elif item.summary %}
          <p class="item-summary">{{ item.summary }}</p>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
  {% endfor %}
</main>

<footer>
  <p>
    Otomatik olarak oluşturuldu &nbsp;·&nbsp;
    <a href="https://github.com/TunaKomurcu/DailyNews" target="_blank" rel="noopener noreferrer">GitHub</a>
    &nbsp;·&nbsp;
    arXiv · OpenAI · The Decoder · Hacker News · TechCrunch · VentureBeat · Hugging Face · MIT Tech Review · DeepMind
  </p>
</footer>

<script>
  // ── Tema (karanlık / aydınlık mod) ──────────────────────────────────────
  const html = document.documentElement;
  const toggleBtn = document.getElementById('theme-toggle');

  function applyTheme(theme) {
    html.setAttribute('data-theme', theme);
    toggleBtn.textContent = theme === 'dark' ? '☀️' : '🌙';
    toggleBtn.setAttribute('title', theme === 'dark' ? 'Aydınlık moda geç' : 'Karanlık moda geç');
  }

  // localStorage'dan kayıtlı tema veya sistem tercihi
  const saved = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  applyTheme(saved || (prefersDark ? 'dark' : 'light'));

  toggleBtn.addEventListener('click', () => {
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    localStorage.setItem('theme', next);
    applyTheme(next);
  });

  // ── Arama ────────────────────────────────────────────────────────────────
  const searchInput = document.getElementById('search-input');
  const searchCount = document.getElementById('search-count');
  const noResults   = document.getElementById('no-results');
  const allItems    = document.querySelectorAll('li.news-item');
  const allSections = document.querySelectorAll('main section');

  searchInput.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    allItems.forEach(item => {
      const title   = item.dataset.title   || '';
      const summary = item.dataset.summary || '';
      const matches = !query || title.includes(query) || summary.includes(query);
      item.classList.toggle('hidden', !matches);
      if (matches) visibleCount++;
    });

    // Tüm haberleri gizlenmiş section'ları sakla
    allSections.forEach(section => {
      const visible = section.querySelectorAll('li.news-item:not(.hidden)').length;
      section.style.display = visible === 0 ? 'none' : '';
    });

    // Sonuç bilgisi
    if (query) {
      searchCount.textContent = visibleCount
        ? visibleCount + ' haber bulundu'
        : '';
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    } else {
      searchCount.textContent = '';
      noResults.style.display = 'none';
      allSections.forEach(s => s.style.display = '');
    }
  });
</script>

</body>
</html>
